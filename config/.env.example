# ═══════════════════════════════════════════════════════════════
# Bookkeeping — SINGLE config file (local dev)
# Copy to .env  →  used by BOTH backend and frontend
# Set the same keys per-project in the Vercel dashboards (no files)
#   Frontend dashboard: VITE_* only
#   Backend dashboard:  everything else (NODE_ENV, PORT, JWT_*, DB_*, SUPABASE_S3_*)
# NEVER prefix secrets with VITE_ (Vite exposes VITE_* to the browser)
# ═══════════════════════════════════════════════════════════════

# ── App metadata ────────────────────────────────────────────────
VITE_APP_NAME=Bookkeeping App
VITE_APP_VERSION=1.0.0

# ── Frontend (Vite) ─────────────────────────────────────────────
# Local: /api (vite dev proxy → localhost:3001)
# Vercel: full backend URL, e.g. https://bookkeeping-api.vercel.app/api
VITE_API_URL=/api

# ── Backend server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001   # Public URL of this backend (used in /api/health). Falls back to the request host if unset.
ALLOWED_IPS=            # empty = open (dev); staging only in Vercel Preview env

# ── Database ────────────────────────────────────────────────────
# Runtime (local + Vercel): pooled connection (port 6543)
DB_URL=postgresql://postgres.<ref>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Migrations/seeds only: direct connection (port 5432). Falls back to DB_URL if unset.
DB_DIRECT_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres

# ── Supabase S3 Storage (receipts) ──────────────────────────────
SUPABASE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=<access-key>
SUPABASE_S3_SECRET_KEY=<secret-key>
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=receipts
